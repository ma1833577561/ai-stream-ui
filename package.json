{
  "name": "ai-stream-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "流式 AI 对话 UI：增量 SSE 解析、断线续传、Markdown 增量渲染、token 级合帧，内置确定性 mock transport。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5"
  },
  "license": "MIT",
  "keywords": [
    "sse",
    "streaming",
    "llm",
    "chat-ui",
    "react",
    "typescript",
    "markdown"
  ],
  "author": "马金栋",
  "homepage": "https://github.com/ma1833577561/ai-stream-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ma1833577561/ai-stream-ui.git"
  },
  "bugs": {
    "url": "https://github.com/ma1833577561/ai-stream-ui/issues"
  }
